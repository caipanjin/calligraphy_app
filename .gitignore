# 忽略 Node.js 模块
node_modules/

# 忽略虚拟环境
venv/
env/

# 忽略编译输出
dist/
build/

# 忽略临时文件和日志文件
*.log
*.tmp

# 忽略 IDE 和编辑器配置文件
.idea/
.vscode/

# 忽略本地 agent 工具状态
.pilotdeck/

# OCR 离线资源由 scripts/fetch-ocr-assets.mjs 生成（约 12MB，不入库）
public/tesseract/

# 忽略测试报告和覆盖率报告
coverage/
reports/

# 忽略 macOS 的 .DS_Store 文件
.DS_Store

# 忽略 Windows 的 Thumbs.db 文件
Thumbs.db
