# 忽略 Node.js 模块
node_modules/

# 忽略虚拟环境
venv/
env/

# 忽略编译输出
dist/
build/

# 忽略临时文件和日志文件
*.log
*.tmp
__pycache__/
*.pyc

# 忽略 IDE 和编辑器配置文件
.idea/
.vscode/

# Android 签名（密钥与密码不入库）
*.jks
*.keystore
keystore.properties
# 忽略本地 agent 工具状态
.pilotdeck/
.workbuddy/

# 忽略本地打包产物（根目录未签名 IPA 等）
*.ipa

# 例外：AltStore 源目录下的 IPA 要入库，由 GitHub Pages 直接托管，
# 这样国内不翻墙也能下载（github.com/releases 直链在国内会超时）。
!altstore/ipa/
!altstore/ipa/*.ipa

# 忽略测试报告和覆盖率报告
coverage/
reports/

# 忽略 macOS 的 .DS_Store 文件
.DS_Store

# 忽略 Windows 的 Thumbs.db 文件
Thumbs.db
